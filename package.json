{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild dist/swarm.js --minify --allow-overwrite --outfile=dist/swarm.js --log-level=warning",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --fix --quiet",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:types && npm run lint:css",
    "start": "serve -s dist -l $PORT"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-router": "^1.168.3",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "^12.10.1",
    "autoprefixer": "10.4.16",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.0.1",
    "postcss": "8.4.31",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "serve": "^14.2.6",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  }
}
